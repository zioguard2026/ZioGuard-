# Public browser configuration. These values are safe to expose only when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_AUTH_REQUIRED=true

# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are also supported for compatibility.
# Never place the Supabase service-role key in a VITE_ or NEXT_PUBLIC_ variable or commit it.
